{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://b12.local/schemas/unified-manifest-v2.json",
  "title": "Unified evaluation manifest v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "run_type",
    "status",
    "commit",
    "dirty",
    "scenario_set_sha256",
    "environment",
    "model",
    "configuration",
    "raw_results"
  ],
  "properties": {
    "schema_version": {"const": 2},
    "run_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "run_type": {"enum": ["software_suite", "model_evaluation"]},
    "status": {
      "enum": ["PLANNED", "RUNNING", "COMPLETED", "FAILED", "BLOCKED", "NOT_EXECUTED"]
    },
    "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "dirty": {"type": "boolean"},
    "scenario_set_sha256": {
      "type": ["string", "null"],
      "pattern": "^[0-9a-f]{64}$"
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["host", "os", "python", "cpu", "gpu", "vram_bytes", "ram_bytes", "power_mode"],
      "properties": {
        "host": {"type": ["string", "null"]},
        "os": {"type": ["string", "null"]},
        "python": {"type": ["string", "null"]},
        "cpu": {"type": ["string", "null"]},
        "gpu": {"type": ["string", "null"]},
        "vram_bytes": {"type": ["integer", "null"], "minimum": 0},
        "ram_bytes": {"type": ["integer", "null"], "minimum": 0},
        "power_mode": {"type": ["string", "null"]}
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "digest", "quantization", "runtime_version", "profile_sha256", "tokenizer_sha256", "chat_template_sha256"],
      "properties": {
        "name": {"type": ["string", "null"]},
        "digest": {"type": ["string", "null"]},
        "quantization": {"type": ["string", "null"]},
        "runtime_version": {"type": ["string", "null"]},
        "profile_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
        "tokenizer_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
        "chat_template_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "configuration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["context_tokens", "output_tokens", "cache_state", "repeats", "snapshot_sha256"],
      "properties": {
        "context_tokens": {"type": ["integer", "null"], "minimum": 1},
        "output_tokens": {"type": ["integer", "null"], "minimum": 1},
        "cache_state": {"enum": ["cold", "warm", "mixed", "unknown", "not_applicable"]},
        "repeats": {"type": ["integer", "null"], "minimum": 1},
        "snapshot_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "suite": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["name", "command", "test_roots", "source_snapshot_sha256", "passed", "skipped", "failed", "duration_seconds"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "command": {"type": "string", "minLength": 1},
        "test_roots": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "source_snapshot_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "passed": {"type": "integer", "minimum": 0},
        "skipped": {"type": "integer", "minimum": 0},
        "failed": {"type": "integer", "minimum": 0},
        "duration_seconds": {"type": "number", "minimum": 0}
      }
    },
    "limitations": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "raw_results": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"run_type": {"const": "software_suite"}}},
      "then": {
        "required": ["suite"],
        "properties": {
          "scenario_set_sha256": {"type": "null"},
          "model": {
            "properties": {
              "name": {"type": "null"},
              "digest": {"type": "null"},
              "quantization": {"type": "null"},
              "runtime_version": {"type": "null"},
              "profile_sha256": {"type": "null"},
              "tokenizer_sha256": {"type": "null"},
              "chat_template_sha256": {"type": "null"}
            }
          },
          "configuration": {
            "properties": {
              "context_tokens": {"type": "null"},
              "output_tokens": {"type": "null"},
              "cache_state": {"const": "not_applicable"}
            }
          }
        }
      }
    },
    {
      "if": {"properties": {"run_type": {"const": "model_evaluation"}}},
      "then": {
        "properties": {
          "scenario_set_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "suite": {"type": "null"},
          "model": {
            "properties": {
              "name": {"type": "string", "minLength": 1},
              "digest": {"type": "string", "minLength": 1},
              "quantization": {"type": "string", "minLength": 1},
              "runtime_version": {"type": "string", "minLength": 1},
              "profile_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
              "tokenizer_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
              "chat_template_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
            }
          },
          "configuration": {
            "properties": {
              "context_tokens": {"type": "integer", "minimum": 1},
              "output_tokens": {"type": "integer", "minimum": 1},
              "cache_state": {"enum": ["cold", "warm", "mixed"]},
              "repeats": {"type": "integer", "minimum": 1},
              "snapshot_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
            }
          }
        }
      }
    }
  ]
}
